- name: epy_block_1
  id: epy_block
  parameters:
    K: '4'
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self,\n                 window_size=500,\n              \
      \   scatter_size=1024,\n                 K=4,\n                 alpha=0.05):\n\
      \n        gr.sync_block.__init__(\n            self,\n            name=\"KMeans\
      \ Live SDR\",\n            in_sig=[np.complex64],\n            out_sig=[np.float32,\
      \ np.complex64, np.complex64]\n        )\n\n        self.window_size = window_size\n\
      \        self.scatter_size = scatter_size\n        self.K = K\n        self.alpha\
      \ = alpha\n\n        # buffer IQ\n        self.buf = np.zeros(window_size, dtype=np.complex64)\n\
      \        self.idx = 0\n\n        # scatter persistence\n        self.scatter_buffer\
      \ = np.zeros(scatter_size, dtype=np.complex64)\n        self.scatter_idx = 0\n\
      \        self.read_idx = 0\n\n        # centres init (random au d\xE9but)\n\
      \        self.centers = np.random.rand(K, 2)\n\n        self.label = 0.0\n \
      \       self.last_point = complex(0, 0)\n\n    def work(self, input_items, output_items):\n\
      \n        x = input_items[0]\n        y_label = output_items[0]\n        y_scatter\
      \ = output_items[1]\n        y_centers = output_items[2]\n\n        for i in\
      \ range(len(x)):\n\n            # -------------------------\n            # BUFFER\
      \ IQ\n            # -------------------------\n            self.buf[self.idx]\
      \ = x[i]\n            self.idx += 1\n\n            if self.idx >= self.window_size:\n\
      \                self.idx = 0\n\n                # NORMALISATION\n         \
      \       power = np.mean(np.abs(self.buf)**2)\n                buf_norm = self.buf\
      \ / np.sqrt(power + 1e-12)\n\n                # FEATURES\n                phase\
      \ = np.unwrap(np.angle(buf_norm))\n                dphase = np.diff(phase)\n\
      \n                mean_dphi = np.mean(np.abs(dphase))\n                var_dphi\
      \ = np.var(dphase)\n\n                point = np.array([mean_dphi, var_dphi])\n\
      \                self.last_point = complex(mean_dphi, var_dphi)\n\n        \
      \        # -------------------------\n                # K-MEANS ONLINE\n   \
      \             # -------------------------\n                dists = np.linalg.norm(self.centers\
      \ - point, axis=1)\n                k = np.argmin(dists)\n\n               \
      \ # update centre k\n                self.centers[k] = self.centers[k] + self.alpha\
      \ * (point - self.centers[k])\n\n                self.label = float(k)\n\n \
      \               # -------------------------\n                # SCATTER BUFFER\n\
      \                # -------------------------\n                self.scatter_buffer[self.scatter_idx]\
      \ = self.last_point\n                self.scatter_idx = (self.scatter_idx +\
      \ 1) % self.scatter_size\n\n                print(f\"point={point}, cluster={k}\"\
      )\n\n            # sortie label\n            y_label[i] = self.label\n\n   \
      \         # scatter points\n            y_scatter[i] = self.scatter_buffer[self.read_idx]\n\
      \            self.read_idx = (self.read_idx + 1) % self.scatter_size\n\n   \
      \         # centres (affichage)\n            c = self.centers[i % self.K]\n\
      \            y_centers[i] = complex(c[0], c[1])\n\n        return len(y_label)\n"
    affinity: ''
    alias: ''
    alpha: '0.05'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scatter_size: '1024'
    window_size: '1000'
  states:
    _io_cache: ('KMeans Live SDR', 'blk', [('window_size', '500'), ('scatter_size',
      '1024'), ('K', '4'), ('alpha', '0.05')], [('0', 'complex', 1)], [('0', 'float',
      1), ('1', 'complex', 1), ('2', 'complex', 1)], '', ['K', 'alpha', 'scatter_size',
      'window_size'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2320, 760.0]
    rotation: 0
    state: enabled
