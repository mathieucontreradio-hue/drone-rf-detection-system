- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    GMSK detector using amplitude + phase dynamics\n    Input :\
      \ complex IQ\n    Output: float32 (0 = GMSK, 1 = noise/other)\n    \"\"\"\n\n\
      \    def __init__(self,\n                 window_size=200,\n               \
      \  var_threshold=0.001,\n                 phase_threshold=0.5):\n\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"GMSK Phase Detector\",\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.float32]\n        )\n\n        self.window_size = window_size\n\
      \        self.var_threshold = var_threshold\n        self.phase_threshold =\
      \ phase_threshold\n\n        self.buffer = np.zeros(window_size, dtype=np.complex64)\n\
      \        self.index = 0\n        self.filled = False\n\n        self.current_decision\
      \ = 1.0\n\n    def work(self, input_items, output_items):\n        in0 = input_items[0]\n\
      \        out = output_items[0]\n\n        for i in range(len(in0)):\n\n    \
      \        # buffer IQ\n            self.buffer[self.index] = in0[i]\n       \
      \     self.index += 1\n\n            if self.index >= self.window_size:\n  \
      \              self.index = 0\n                self.filled = True\n\n      \
      \          # -------------------------\n                # AMPLITUDE ANALYSIS\n\
      \                # -------------------------\n                mag = np.abs(self.buffer)\n\
      \                var_amp = np.var(mag)\n\n                # -------------------------\n\
      \                # PHASE ANALYSIS (KEY POINT)\n                # -------------------------\n\
      \                phase = np.unwrap(np.angle(self.buffer))\n                dphase\
      \ = np.diff(phase)\n                var_phase = np.var(dphase)\n\n         \
      \       # DEBUG l\xE9ger\n                print(f\"[DBG] var_amp={var_amp:.6f},\
      \ var_phase={var_phase:.6f}\")\n\n                # -------------------------\n\
      \                # DECISION\n                # -------------------------\n \
      \               if var_phase < self.phase_threshold:\n                    #\
      \ phase stable \u2192 possible GMSK\n                    if var_amp < self.var_threshold:\n\
      \                        self.current_decision = 0.0  # GMSK\n             \
      \       else:\n                        self.current_decision = 1.0\n       \
      \         else:\n                    # phase random \u2192 bruit\n         \
      \           self.current_decision = 1.0\n\n            out[i] = self.current_decision\n\
      \n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_threshold: '0.1'
    var_threshold: '0.05'
    window_size: '200'
  states:
    _io_cache: '(''GMSK Phase Detector'', ''blk'', [(''window_size'', ''200''), (''var_threshold'',
      ''0.001''), (''phase_threshold'', ''0.5'')], [(''0'', ''complex'', 1)], [(''0'',
      ''float'', 1)], ''\n    GMSK detector using amplitude + phase dynamics\n    Input
      : complex IQ\n    Output: float32 (0 = GMSK, 1 = noise/other)\n    '', [''phase_threshold'',
      ''var_threshold'', ''window_size''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2320, 760.0]
    rotation: 0
    state: enabled
