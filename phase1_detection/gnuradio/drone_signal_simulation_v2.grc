- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self,\n                 window_size=500,\n              \
      \   power_db_threshold=-40):\n\n        gr.sync_block.__init__(\n          \
      \  self,\n            name=\"Stable RF Classifier\",\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.float32]\n        )\n\n        self.window_size = window_size\n\
      \        self.power_db_threshold = power_db_threshold\n\n        self.buf =\
      \ np.zeros(window_size, dtype=np.complex64)\n        self.idx = 0\n\n      \
      \  self.label = 0.0\n\n    def work(self, input_items, output_items):\n\n  \
      \      x = input_items[0]\n        y = output_items[0]\n\n        for i in range(len(x)):\n\
      \n            self.buf[self.idx] = x[i]\n            self.idx += 1\n\n     \
      \       if self.idx >= self.window_size:\n                self.idx = 0\n\n \
      \               # -------------------------\n                # NORMALISATION\
      \ PUISSANCE\n                # -------------------------\n                power\
      \ = np.mean(np.abs(self.buf)**2)\n                power_db = 10 * np.log10(power\
      \ + 1e-12)\n\n                # -------------------------\n                #\
      \ PHASE FEATURES\n                # -------------------------\n            \
      \    phase = np.unwrap(np.angle(self.buf))\n                dphase = np.diff(phase)\n\
      \n                mean_dphi = np.mean(np.abs(dphase))\n                var_dphi\
      \ = np.var(dphase)\n\n                # -------------------------\n        \
      \        # DEBUG (important)\n                # -------------------------\n\
      \                print(f\"Pdb={power_db:.2f}, dphi={mean_dphi:.3f}, var={var_dphi:.3f}\"\
      )\n\n                # -------------------------\n                # CLASSIFICATION\
      \ LOGIQUE\n                # -------------------------\n\n                #\
      \ 1. NOISE\n                if power_db < self.power_db_threshold:\n       \
      \             self.label = 0.0\n\n                else:\n                  \
      \  # 2. AM\n                    if mean_dphi < 0.1:\n                      \
      \  self.label = 1.0\n\n                    else:\n                        #\
      \ 3. FSK vs GMSK vs NOISE FM\n                        if mean_dphi > 0.55:\n\
      \                            # FSK check robuste\n                         \
      \   if var_dphi > 0.6:\n                                self.label = 2.0\n \
      \                           else:\n                                self.label\
      \ = 0.0  # bruit FM mal structur\xE9\n\n                        elif mean_dphi\
      \ < 0.35:\n                            self.label = 3.0  # GMSK\n\n        \
      \                else:\n                            self.label = 0.0  # noise\
      \ zone interm\xE9diaire\n\n            y[i] = self.label\n\n        return len(y)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    power_db_threshold: '-44'
    window_size: '500'
  states:
    _io_cache: ('Stable RF Classifier', 'blk', [('window_size', '500'), ('power_db_threshold',
      '-40')], [('0', 'complex', 1)], [('0', 'float', 1)], '', ['power_db_threshold',
      'window_size'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2320, 760.0]
    rotation: 0
    state: enabled
