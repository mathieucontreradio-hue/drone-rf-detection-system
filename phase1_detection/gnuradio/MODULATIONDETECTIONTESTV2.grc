- name: epy_block_0
  id: epy_block
  parameters:
    N: '4096'
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):  # other base classes\
      \ are basic_block, decim_block, interp_block\n    \"\"\"Embedded Python Block\
      \ example - a simple multiply const\"\"\"\n\n    def __init__(self, N=4096):\
      \  # only default arguments here\n        \"\"\"arguments to this function show\
      \ up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n         \
      \   self,\n            name='mean power calculation',   \n            in_sig=[np.complex64],\n\
      \            out_sig=[np.float32]\n        )\n        \n        self.N = N\n\
      \        self.buffer = np.zeros(self.N, dtype=np.complex64)\n        self.idx\
      \ = 0\n        self.last_power = 0.0\n        \n        \n    def meanpower(self,x):\n\
      \    \tpower=np.mean(np.abs(x)**2)\n    \treturn power   \n\n    def work(self,\
      \ input_items, output_items):\n        in0 = input_items[0]\n        out = output_items[0]\n\
      \        \n        for i in range(len(in0)):\n        \n        \tself.buffer[self.idx]\
      \ = in0[i]\n        \tself.idx += 1\n        \t\n        \tif self.idx >= self.N:\n\
      \        \t\n        \t\tself.last_power = self.meanpower(self.buffer)\n   \
      \     \t\tself.idx = 0\n        \t\t\n        \tout[i] = self.last_power\n \
      \       \t\t\n        \t\t\n        \n        \t\n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('mean power calculation', 'blk', [('N', '4096')], [('0', 'complex',
      1)], [('0', 'float', 1)], 'Embedded Python Block example - a simple multiply
      const', ['N'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1120, 40.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    SNR: '20'
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self, SNR=-20):\n\n        gr.sync_block.__init__(\n    \
      \        self,\n            name='SNR noise adder',\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.complex64]\n        )\n\n        self.snr_db = SNR\n\
      \n    def work(self, input_items, output_items):\n\n        x = input_items[0]\n\
      \        out = output_items[0]\n\n        # puissance signal\n        Ps = np.mean(np.abs(x)**2)\n\
      \n        # normalisation (puissance \u2248 1)\n        x_norm = x / (np.sqrt(Ps)\
      \ + 1e-12)\n\n        # puissance bruit depuis SNR\n        Pn = 1.0 / (10 **\
      \ (self.snr_db / 10))\n\n        # bruit complexe unit\xE9\n        noise =\
      \ (np.random.randn(len(x)) + 1j*np.random.randn(len(x))) / np.sqrt(2)\n\n  \
      \      # mise \xE0 l'\xE9chelle bruit\n        noise *= np.sqrt(Pn)\n\n    \
      \    # signal final\n        out[:] = x_norm + noise\n        \n  #      print(\"\
      SNR target;\", self.snr_db)\n   #     print(\"measured SNR;\",10*np.log10(Ps/Pn))\n\
      \n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('SNR noise adder', 'blk', [('SNR', '-20')], [('0', 'complex', 1)],
      [('0', 'complex', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1496, 424.0]
    rotation: 0
    state: enabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport joblib\nfrom gnuradio import gr\nfrom\
      \ scipy.stats import kurtosis\nimport warnings\n\nwarnings.filterwarnings(\"\
      ignore\")\n\n\nclass blk(gr.sync_block):\n\n    def __init__(self):\n\n    \
      \    gr.sync_block.__init__(\n            self,\n            name=\"RF Fast\"\
      ,\n            in_sig=[np.complex64],\n            out_sig=[np.float32]\n  \
      \      )\n\n        self.model = joblib.load(\n            \"/home/mathi/DRONE_DETECTION_PROJECT/1_MODULATION_DETECTION/PYTHON_SCRIPTS/rf_model.pkl\"\
      \n        )\n\n        self.scaler = joblib.load(\n            \"/home/mathi/DRONE_DETECTION_PROJECT/1_MODULATION_DETECTION/PYTHON_SCRIPTS/scaler.pkl\"\
      \n        )\n\n        self.N = 512\n        self.buffer = np.zeros(self.N,\
      \ dtype=np.complex64)\n        self.idx = 0\n\n    # ============================================================\n\
      \    # FEATURE EXTRACTION\n    # ============================================================\n\
      \    def extract_features(self, iq):\n\n        amp = np.abs(iq)\n        phase\
      \ = np.unwrap(np.angle(iq))\n        dphi = np.diff(phase)\n        inst_freq\
      \ = dphi / (2 * np.pi)\n\n        # FAST PSD (FFT instead of Welch)\n      \
      \  fft = np.fft.fft(iq)\n        psd = np.abs(fft) ** 2\n        psd = psd /\
      \ (np.sum(psd) + 1e-12)\n\n        entropy = -np.sum(psd * np.log2(psd + 1e-12))\n\
      \n        spectral_flatness = (\n            np.exp(np.mean(np.log(psd + 1e-12)))\
      \ /\n            (np.mean(psd) + 1e-12)\n        )\n\n        cyclo = np.abs(np.mean(iq[:-1]\
      \ * np.conj(iq[1:])))\n\n        features = np.array([\n            np.var(amp),\n\
      \            np.mean(dphi),\n            np.var(dphi),\n            np.var(inst_freq),\n\
      \            kurtosis(inst_freq),\n            entropy,\n            spectral_flatness,\n\
      \            cyclo\n        ]).reshape(1, -1)\n\n        return features\n\n\
      \    # ============================================================\n    # GNU\
      \ RADIO LOOP\n    # ============================================================\n\
      \    def work(self, input_items, output_items):\n\n        in0 = input_items[0]\n\
      \        out = output_items[0]\n\n        for sample in in0:\n\n           \
      \ self.buffer[self.idx] = sample\n            self.idx += 1\n\n            if\
      \ self.idx == self.N:\n\n                feats = self.extract_features(self.buffer)\n\
      \                feats = self.scaler.transform(feats)\n\n                pred\
      \ = self.model.predict(feats)[0]\n\n                # broadcast prediction over\
      \ output chunk\n                out[:] = pred\n\n                self.idx =\
      \ 0\n                return len(out)\n\n        out[:] = -1\n        return\
      \ len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('RF Fast', 'blk', [], [('0', 'complex', 1)], [('0', 'float', 1)],
      '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1672, 432.0]
    rotation: 0
    state: enabled
